# ver https://matplotlib.org/stable/tutorials/introductory/customizing.html
lines.linewidth: 4
lines.solid_capstyle: butt

legend.fancybox: true

# "Verdana" para el texto que no es matemático,
# Cambria Math

#Azul (Crayon-Aqua) 0096FF
#Rojo oscuro C00000
#Naranja (Apple Orange) FF9300
#Negro 000000
#Magenta FF40FF
#Morado 7030A0

axes.prop_cycle: cycler('color', ['0096FF', 'FF9300', 'FF40FF', '7030A0', 'C00000'])
#axes.facecolor: f0f0f0 # gris
axes.facecolor: ffffff  # blanco
axes.labelsize: large
axes.axisbelow: true
axes.grid: False
axes.edgecolor: f0f0f0
axes.linewidth: 3.0
axes.titlesize: x-large

patch.edgecolor: f0f0f0
patch.linewidth: 0.5

svg.fonttype: path

grid.linestyle: -
grid.linewidth: 1.0
grid.color: cbcbcb

xtick.major.size: 0
xtick.minor.size: 0
ytick.major.size: 0
ytick.minor.size: 0

savefig.edgecolor: f0f0f0
savefig.facecolor: f0f0f0

#figure.subplot.left: 0.08
#figure.subplot.right: 0.95
#figure.subplot.bottom: 0.07

#figure.facecolor: f0f0f0  # gris
figure.facecolor: ffffff  # blanco

## ***************************************************************************
## * FUENTE                                                                  *
## ***************************************************************************
## Propiedades de fuente que usa `text.Text`.
## Consulta https://matplotlib.org/api/font_manager_api.html para más
## información sobre las propiedades de fuente. Abajo se indican las 6
## propiedades que se usan para seleccionar la fuente, con sus valores por defecto.
##
## La propiedad font.family puede recibir el nombre de una fuente concreta (no
## se admite al renderizar texto con usetex) o uno de estos cinco valores
## genéricos:
##     - 'serif' (p. ej., Times),
##     - 'sans-serif' (p. ej., Helvetica),
##     - 'cursive' (p. ej., Zapf-Chancery),
##     - 'fantasy' (p. ej., Western), y
##     - 'monospace' (p. ej., Courier).
## Cada uno de estos valores tiene una lista de fuentes por defecto
## (font.serif, etc.); se usa la primera fuente disponible de la lista. Observa
## que, para font.serif, font.sans-serif y font.monospace, siempre se usará el
## primer elemento de la lista (una fuente DejaVu), porque DejaVu viene incluida
## con Matplotlib y por lo tanto siempre está disponible; las demás entradas
## se dejan como ejemplos de otros valores posibles.
##
## La propiedad font.style tiene tres valores: normal (o roman), italic
## u oblique. Si no existe la versión italic, se usará la oblique.
##
## La propiedad font.variant tiene dos valores: normal o small-caps. En las
## fuentes TrueType, que son escalables, small-caps equivale a usar un tamaño
## de fuente 'smaller', es decir, alrededor del 83%% del tamaño de fuente
## actual.
##
## La propiedad font.weight tiene en la práctica 13 valores: normal, bold,
## bolder, lighter, 100, 200, 300, ..., 900. Normal equivale a 400 y bold
## a 700. bolder y lighter son valores relativos al grosor actual.
##
## La propiedad font.stretch tiene 11 valores: ultra-condensed,
## extra-condensed, condensed, semi-condensed, normal, semi-expanded,
## expanded, extra-expanded, ultra-expanded, wider y narrower. Esta
## propiedad todavía no está implementada.
##
## La propiedad font.size es el tamaño de fuente por defecto del texto, en
## puntos. El valor estándar es 10 pt.
##
## Observa que font.size controla los tamaños de texto por defecto. Para
## configurar tamaños especiales (etiquetas de las marcas, ejes, etiquetas,
## título, etc.), consulta los parámetros rc de los ejes y las marcas. Los
## tamaños especiales se pueden definir en relación con font.size, usando estos
## valores: xx-small, x-small, small, medium, large, x-large, xx-large, larger
## o smaller


font.family:  sans-serif
font.style:   normal
font.variant: normal
font.weight:  normal
font.stretch: normal
font.size:    8.0

font.serif:      DejaVu Serif, Bitstream Vera Serif, Computer Modern Roman, New Century Schoolbook, Century Schoolbook L, Utopia, ITC Bookman, Bookman, Nimbus Roman No9 L, Times New Roman, Times, Palatino, Charter, serif
font.sans-serif: Verdana, DejaVu Sans, Bitstream Vera Sans, Computer Modern Sans Serif, Lucida Grande, Geneva, Lucid, Arial, Helvetica, Avant Garde, sans-serif
font.cursive:    Apple Chancery, Textile, Zapf Chancery, Sand, Script MT, Felipa, Comic Neue, Comic Sans MS, cursive
font.fantasy:    Chicago, Charcoal, Impact, Western, Humor Sans, xkcd, fantasy
font.monospace:  DejaVu Sans Mono, Bitstream Vera Sans Mono, Computer Modern Typewriter, Andale Mono, Nimbus Mono L, Courier New, Courier, Fixed, Terminal, monospace


